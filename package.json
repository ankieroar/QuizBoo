{
  "name": "troll-quiz-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.example.jsonc --local --persist-to .wrangler/local-test",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute troll-quiz-db --config wrangler.example.jsonc --local --persist-to .wrangler/local-test --file=./schema.sql",
    "db:remote": "wrangler d1 execute troll-quiz-db --remote --file=./schema.sql",
    "check": "node --check src/worker.js && node --check public/app.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
