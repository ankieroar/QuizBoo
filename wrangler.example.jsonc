{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "troll-quiz-room",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "troll-quiz-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
